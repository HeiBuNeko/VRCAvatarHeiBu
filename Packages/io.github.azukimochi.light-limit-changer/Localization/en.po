##################
## Other Settings

msgid "settings:other/excludes/label"
msgstr "Exclude Settings"

msgid "settings:other/excludes/description"
msgstr ""
"Exclude settings allow you to exclude specific materials in the avatar from being controlled.\n"
"By directly specifying the material, you can exclude only specific materials from being controlled."

msgid "settings:other/excludes/exclude-object"
msgstr "Exclude Objects"

msgid "settings:other/excludes/add-section/game-object"
msgstr "Object to Add"

msgid "settings:other/excludes/add-section/material"
msgstr "Material to Add"

msgid "settings:other/excludes/include-children"
msgstr "Include Children"

msgid "settings:other/writedefault/label"
msgstr "Write Defaults Setting"

msgid "settings:other/writedefault/description"
msgstr ""
"The Write Defaults setting allows changes to the Write Defaults setting for generated animations.\n"
"Normally, this is automatically adjusted to match the avatar, but you can manually adjust it if issues arise."

msgid "settings:other/target_shader/label"
msgstr "Target Shader"

msgid "settings:other/target_shader/description"
msgstr ""
"The Target Shader parameter specifies the shader to which settings are applied.\n"
"You can exclude specific shaders from being controlled."

msgid "settings:other/include-particle-system"
msgstr "Particle System Setting"

msgid "settings:other/include-particle-system/label"
msgstr "Include Particle System"

msgid "settings:other/include-particle-system/description"
msgstr "This setting allows you to generate animations to control brightness etc. if the particle system contains the target shader."

msgid "settings:other/language/label"
msgstr "Language Setting"

msgid "settings:other/compress-expression-parameters/label"
msgstr "Parameter Compression"

msgid "settings:other/compress-expression-parameters/description"
msgstr ""
"This feature compresses the parameters used by the Light Limit Changer feature.\n\n"
"By enabling this feature, float parameters can be compressed to a total of 16 bits.\n"
"However, this may result in slower synchronization speeds."

msgid "settings:other/parameter-sync-frequency/label"
msgstr "Parameter Sync Frequency (sec)"

msgid "settings:other/parameter-sync-frequency/description"
msgstr ""
"(Advanced) Set how often parameter syncing will start, in seconds.\n"
"Closer to 0 means faster, larger values mean slower."

msgid "settings:other/add-manual-sync-button/label"
msgstr "Add Manual-Sync Button"

msgid "settings:other/add-manual-sync-button/description"
msgstr ""
"Add a button to the menu to manually start parameter synchronization.\n"
"It is intended to be used in conjunction with slowing down the parameter synchronization frequency."

msgid "settings:other/allow-force-override-same-reference/label"
msgstr "Force Override for Identical References"

msgid "settings:other/allow-force-override-same-reference/description"
msgstr ""
"When baking, this feature overrides textures that share the same reference as the main texture within the material.\n"
"Enabling this feature allows both the main texture and outline texture (if sharing the same reference) to be overridden after baking.\n"
"This can reduce VRAM usage but may alter the appearance."

msgid "settings:other/preset"
msgstr "Preset"

msgid "settings:other/generate-default-preset"
msgstr "Generate Default Preset"

msgid "settings:other/preset/description"
msgstr "Add initial value presets to reset each parameter."

msgid "settings:other/dynamic-preset/label"
msgstr "Dynamic Presets"

msgid "settings:other/dynamic-preset/generate-dynamic-preset"
msgstr "Enable Save Slots"

msgid "settings:other/dynamic-preset/dynamic-preset-slot-count"
msgstr "Number of Save Slots"

msgid "settings:other/dynamic-preset/description"
msgstr ""
"Adds save slots to save and load current settings from the EX menu."

msgid "settings:other/ndmf-preview/title"
msgstr ""
"NDMF Preview"

msgid "settings:other/ndmf-preview/label"
msgstr ""
"Enable Realtime Preview"

msgid "settings:other/ndmf-preview/description"
msgstr ""
"Enables NDMF preview.\n"
"This allows you to see your values being overwritten in real time.\n"
"Please note that Color Control Settings are not reflected in the preview."

msgid "settings:other/mesh-settings/title"
msgstr "Mesh Settings"

msgid "settings:other/mesh-settings/override-settings"
msgstr "Override Mesh Settings"

msgid "settings:other/mesh-settings/anchor-override"
msgstr "Anchor Override"

msgid "settings:other/mesh-settings/root-bone"
msgstr "Root Bone"

msgid "settings:other/mesh-settings/bounds"
msgstr "Bounds"

msgid "settings:other/mesh-settings/description"
msgstr ""
"When this function is enabled, you can make the Root Bone and Bounds of the avatar common.\n"
"If there is an MA MeshSettings in the avatar root, the contents will be overwritten, and if not, a new one will be generated.\n"
"If there is another MA MeshSettings in the avatar, the settings for all components except [Not set] will be changed to [Inherit]."

msgid "settings:other/menu-settings/title"
msgstr "Menu Settings"

msgid "settings:other/menu-settings/unfold-group-menus"
msgstr "Don't create hierarchical menus"

msgid "settings:other/error-suppression/title"
msgstr "Warning Suppression"

msgid "settings:other/error-suppression/mixed-shader-warning/label"
msgstr "Suppress Mixed Shader Warning"

msgid "settings:other/error-suppression/mixed-shader-warning/warning"
msgstr ""
"Enabling this option will suppress warnings about objects that have mixed shaders.\n"
"Note that suppressing warnings may cause you to overlook issues that are actually occurring.\n"
"\n"
"If a warning is displayed, it is recommended to add the relevant object to the exclude list.\n"
"This setting affects the behavior of all Light Limit Changers in the project."

##################
## Migration

msgid "migration:v1/message"
msgstr ""
"This component is outdated and incompatible with Light Limit Changer Ver.2 and later.\n"
"\n"
"By pressing the 'Migrate' button below, you can migrate (transfer) settings from LLC 1.x to components for v2.x while retaining some of the previously configured values."

##################
## Error Messages

## When old LLC is still present
msgid "error:found-old-version/title"
msgstr ""
"An outdated Light Limit Changer component has been found in the avatar."

msgid "error:found-old-version/details"
msgstr ""
"The outdated component does not generate animations at runtime.\n"

msgid "error:found-old-version/hint"
msgstr ""
"Remove the outdated component and reinstall Light Limit Changer, or migrate the outdated component to the latest version using the inspector."

msgid "error:duplicate-installed"
msgstr ""
"Multiple instances of Light Limit Changer were detected in the avatar, so this object has been blocked."

msgid "error:duplicate-object-name/title"
msgstr "The object name being animated is duplicated."

msgid "error:duplicate-object-name/details"
msgstr ""
"An object with the same name exists in the same hierarchy.\n"
"This may cause animations to not work properly.\n"
"If this issue occurs, rename the following object:"

msgid "error:failed-to-add/vrc-avatar-parameter-driver"
msgstr ""
"Failed to add VRCAvatarParameterDriver.\n"
"Check if there are any compile errors caused by other scripts."

## When using unsupported Poiyomi Toon version
msgid "error:poiyomi/exist-unsupported-version/title"
msgstr ""
"Poiyomi Toon version {0} is currently not supported."

msgid "error:unlitwf/bake-shader-not-found/title"
msgstr ""
"The baking shader for UnlitWF was not found, so the baking process was skipped."

msgid "error:unlitwf/bake-shader-not-found/hint"
msgstr ""
"Updating the version of the UnlitWF Shader to the latest may resolve this issue."

msgid "error:liltoon/exist-lilmulti/title"
msgstr ""
"Materials using the lilToonMulti shader were found in the avatar.\n"
"Some animations may not function correctly."

msgid "error:network-timeout"
msgstr ""
"Communication with the authentication server timed out.\n"
"Please check your communication environment and try again."

msgid "error:not-verified"
msgstr ""
Light Limit Changer is not authenticated. The process has been canceled.\n"
"Please open the authentication screen and complete the authentication process."

## When a renderer has both supported and unsupported shaders
msgid "warning:renderer/mixed-shaders/title"
msgstr "There is an object that contains a mix of compatible and incompatible shaders."

msgid "warning:renderer/mixed-shaders/details"
msgstr ""
"When animations are applied to this renderer, unsupported materials on it will also be animated unintentionally, which may produce unintended visual results.\n"
"Unsupported shaders: {0}\n"

