<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="ParameterFieldContainer" style="flex-direction: column;">
        <ui:VisualElement name="ParameterField" style="flex-direction: row; -unity-text-align: middle-left;">
            <ui:TextField picking-mode="Ignore" name="NameField" style="margin-left: 0; margin-right: 8px; margin-top: 0; margin-bottom: 0; text-overflow: ellipsis; white-space: normal; flex-shrink: 1; flex-grow: 1; min-width: 64px;" />
            <ui:EnumField type="VRC.SDK3.Avatars.ScriptableObjects.VRCExpressionParameters+ValueType, VRCSDK3A" name="TypeField" style="width: 72px; margin-left: 0; margin-right: 8px; margin-top: 0; margin-bottom: 0;" />
            <ui:VisualElement name="DefaultBoolContainer" style="width: 60px; margin-right: 8px; justify-content: center; align-items: center; flex-shrink: 0;">
                <ui:Toggle name="DefaultBoolField" style="margin: 0; padding: 0;" />
            </ui:VisualElement>
            <ui:IntegerField name="DefaultIntField" style="width: 60px; margin-left: 0; margin-right: 8px; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0;" />
            <ui:FloatField name="DefaultFloatField" style="width: 60px; margin-left: 0; margin-right: 8px; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0;" />
            <ui:Toggle name="SavedField" style="margin-left: 20px; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 40px;" />
            <ui:Toggle name="SyncedField" style="margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 20px;" />
        </ui:VisualElement>
        <ui:VisualElement name="AdvancedOptionsContainer" style="flex-direction: column; padding-left: 16px; padding-top: 4px; padding-bottom: 4px; background-color: rgba(0, 0, 0, 0.1);">
            <ui:VisualElement name="LerpDurationRow" style="flex-direction: row; -unity-text-align: middle-left; margin-bottom: 4px;">
                <ui:Label text="Lerp Duration:" style="width: 90px; -unity-text-align: middle-left; margin-right: 4px;" />
                <ui:DropdownField name="DurationTypeField" style="width: 80px; margin-left: 0; margin-right: 8px; margin-top: 0; margin-bottom: 0;" choices="Default, Custom" value="Default" />
                <ui:FloatField name="DurationField" style="width: 40px; margin-left: 0; margin-right: 16px; margin-top: 0; margin-bottom: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="BitWidthRow" style="flex-direction: row; -unity-text-align: middle-left;">
                <ui:Label text="Bits:" style="width: 30px; -unity-text-align: middle-left; margin-right: 4px;" />
                <ui:IntegerField name="BitWidthField" style="width: 40px; margin-left: 0; margin-right: 16px; margin-top: 0; margin-bottom: 0;" />
                <ui:Label text="Representation:" style="-unity-text-align: middle-left; margin-right: 4px;" />
                <ui:EnumField name="RepresentationField" type="VRC.SDK3.Avatars.ScriptableObjects.VRCExpressionParameters+Parameter+ValueRepresentation, VRCSDK3A" style="width: 100px; margin-left: 0; margin-right: 16px; margin-top: 0; margin-bottom: 0;" />
                <ui:Label name="InfoLabel" style="width: 80px; margin-left: 0; margin-right: 8px; margin-top: 0; margin-bottom: 0; -unity-text-align: middle-left;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
